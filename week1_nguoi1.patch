+        "TRAINING",
+        "EMPLOYEE_OBLIGATIONS_DISCIPLINE",
+        "EMPLOYER_RIGHTS_OBLIGATIONS",
+        "TERMINATION",
+        "OTHER"
+      ]
+    }
+  }
+}
