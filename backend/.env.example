DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/contract_risk_db

# PDF resource budgets. Restart API workers after changing limits.
PDF_MAX_BYTES=10485760
PDF_MAX_PAGES=100
PDF_MAX_TEXT_CHARS=300000
PDF_PARSE_TIMEOUT_SECONDS=10
PDF_WORKER_MEMORY_MB=512
PDF_MAX_CONCURRENT_UPLOADS=2
PDF_UPLOADS_PER_MINUTE=30
PDF_BODY_TIMEOUT_SECONDS=30
PDF_MAX_STORED_CONTRACTS=1000
PDF_MAX_STORED_TEXT_CHARS=10000000
