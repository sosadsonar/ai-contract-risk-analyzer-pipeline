# Runtime configuration; copy to .env at repository root. Do not commit secrets.
APP_ENV=dev
# gemini | local (Ollama) | fake (tất định, offline — smoke/CI/ghép frontend; KHÔNG dùng để đo chất lượng).
# Dev không có provider (gemini mà thiếu key/model) ⇒ API trả fixture mẫu, không phân tích file upload.
DEV_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL_ID=
MAX_UPLOAD_MB=10
SESSION_TTL_MINUTES=60
EXPIRED_TOMBSTONE_HOURS=24
OPS_DB_PATH=./runtime/ops_metadata.sqlite3
# Dev generates an in-process salt when unset; demo/eval require a stable secret.
RATE_LIMIT_HMAC_SALT=
RATE_LIMIT_UPLOADS=5
RATE_LIMIT_WINDOW_SECONDS=600
# Dev skips quota only when either value is missing; demo/eval require both.
# SRS OI-05 (OPEN_ISSUES_HANDLE_v4 §2): GIÁ TRỊ TẠM, tune sau số đo end-to-end (classify + risk) trên D1.
# SESSION_CALL_RESERVE là ngưỡng admission (nhận phiên mới khi còn >= 40 call trong ngày UTC), KHÔNG giữ
# riêng 40 call và không bảo đảm phiên hoàn thành. DAILY_LLM_CALL_QUOTA đếm call kể cả retry; retry của
# phiên đã nhận có thể vượt quota, nên 300 là giới hạn số call, KHÔNG phải trần chi tiêu USD.
DAILY_LLM_CALL_QUOTA=300
SESSION_CALL_RESERVE=40
# Giá model (USD / 1M token) + nguồn chính thức và ngày hiệu lực. Để trống khi chưa đối chiếu trang giá
# chính thức của Google; khi trống, cost trong ledger = 0.0 nghĩa là "chưa biết", không phải miễn phí.
# LLM_PRICE_INPUT_USD_PER_MTOK=
# LLM_PRICE_OUTPUT_USD_PER_MTOK=
# LLM_PRICE_SOURCE=
# Provider LLM (W3, N1): batch/parallelism/timeout dùng default của Settings nếu để trống.
# DEV_LLM_PROVIDER=local chỉ ở APP_ENV=dev, dữ liệu đã de-identify; Ollama mặc định http://localhost:11434.
OLLAMA_BASE_URL=
# Kho luật (tương đối với thư mục gốc). demo/eval yêu cầu manifest APPROVED; dev cho phép DRAFT.
LEGAL_CORPUS_DIR=data/legal_corpus
# version_pins.app_commit (EV-07): SHA 40 ký tự; để trống thì backend tự đọc `git rev-parse HEAD`.
APP_COMMIT=
