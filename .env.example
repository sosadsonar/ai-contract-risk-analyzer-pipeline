# Copy file này thành .env (đã có trong .gitignore, KHÔNG commit .env thật) rồi điền giá trị.
#   macOS/Linux:  cp .env.example .env
#   Windows CMD:  copy .env.example .env
#   PowerShell:   Copy-Item .env.example .env
# Đặt .env ở THƯ MỤC GỐC repo (cùng cấp README.md).

# Chọn provider mặc định: "gemini" hoặc "qwen_ollama"
LLM_PROVIDER=gemini

# --- Gemini (free tier) ---
# Lấy API key miễn phí tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Qwen qua Ollama (chạy local, miễn phí hoàn toàn, không cần API key) ---
# Cài đặt: https://ollama.com/download
# Sau khi cài: ollama pull qwen2.5:7b   (máy yếu dùng qwen2.5:3b)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
