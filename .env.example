# Runtime configuration; copy to .env at repository root. Do not commit secrets.
APP_ENV=dev
DEV_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL_ID=
MAX_UPLOAD_MB=10
SESSION_TTL_MINUTES=60
EXPIRED_TOMBSTONE_HOURS=24
OPS_DB_PATH=./runtime/ops_metadata.sqlite3
# Dev generates an in-process salt when unset; demo/eval require a stable secret.
RATE_LIMIT_HMAC_SALT=
RATE_LIMIT_UPLOADS=5
RATE_LIMIT_WINDOW_SECONDS=600
# Dev skips quota only when either value is missing; demo/eval require both.
DAILY_LLM_CALL_QUOTA=
SESSION_CALL_RESERVE=
